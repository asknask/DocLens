# ===========================================
# DocLens Configuration
# ===========================================
# Copy this file to .env in the root directory
# Both backend and frontend can reference these values

# ===========================================
# Backend: OpenAI API Configuration
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ===========================================
# Backend: AWS Configuration (Optional - for Textract)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
TEXTRACT_ENABLED=false

# ===========================================
# Backend: Application Settings
# ===========================================
DEBUG=false
STORAGE_DIR=./storage
STORAGE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5

# ===========================================
# Backend: File Limits
# ===========================================
MAX_FILE_SIZE_PDF=20971520
MAX_FILE_SIZE_DOCX=10485760
MAX_FILE_SIZE_IMAGE=10485760
MAX_PDF_PAGES=50
MAX_DOCX_CHARS=500000
MAX_DOCX_IMAGES=20

# ===========================================
# Backend: Vision Limits
# ===========================================
MAX_VISION_PAGES=10
VISION_PAGE_RATIO=0.2
MAX_VISION_IMAGES=10

# ===========================================
# Backend: Rate Limiting
# ===========================================
RATE_LIMIT_UPLOADS_PER_HOUR=5
RATE_LIMIT_RUNS_PER_HOUR=20
PROCESSING_TIMEOUT_SECONDS=60

# ===========================================
# Backend: CORS Settings
# ===========================================
CORS_ORIGINS=["http://localhost:3000"]

# ===========================================
# Frontend: API Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
