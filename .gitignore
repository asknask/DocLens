# ===========================================
# DocLens Monorepo - Root .gitignore
# ===========================================

# Environment files (contain secrets!)
.env
.env.*
!.env.example

# ===========================================
# Backend (Python/FastAPI)
# ===========================================
backend/storage/
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
backend/*.egg-info/
backend/dist/
backend/build/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# ===========================================
# Frontend (Node/Next.js)
# ===========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/.vercel
frontend/*.tsbuildinfo
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# ===========================================
# IDE & Editors
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ===========================================
# OS Files
# ===========================================
.DS_Store
Thumbs.db
Desktop.ini

# ===========================================
# Misc
# ===========================================
*.log
*.pem
